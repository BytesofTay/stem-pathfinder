{
  "name": "stem-pathfinder-browser-checks",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build:chat-data": "node scripts/build-chat-data.cjs",
    "check:chat-data": "node scripts/build-chat-data.cjs --check",
    "test:chat": "node --test tests/chat-*.test.*",
    "test:api": "node --test tests/server.test.cjs tests/chat-server.test.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/matching.test.cjs tests/application-guide.test.cjs tests/application-guidance.test.mjs tests/evidence.test.cjs tests/chat-catalog.test.cjs tests/chat-core.test.mjs tests/chat-http.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.99",
    "@netlify/blobs": "^10.7.0",
    "ai": "^7.0.148",
    "better-sqlite3": "^12.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
